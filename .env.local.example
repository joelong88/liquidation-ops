# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings -> API page. NEXT_PUBLIC_* values are safe to expose to the browser;
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to the client — it bypasses RLS
# and is used only in server-only code (sync job routes under app/api/sync/*).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked by app/api/sync/* routes so the sync endpoints can't be
# triggered by anyone who finds the URL. Generate with: openssl rand -hex 32
CRON_SECRET=
