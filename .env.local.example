# Copy to .env.local (gitignored). A local MySQL-wire database is required — Substrait
# provisions OceanBase in deployed environments, but locally you point DATABASE_URL at
# your own MySQL/MariaDB instance and run the Flyway migrations against it yourself.

DATABASE_URL=

# SSO shim: src/proxy.ts and src/lib/auth/profile.ts fall back to this email when
# NODE_ENV !== 'production' — there's no Google-SSO reverse proxy running locally, so
# without this every /ops page is unreachable (requireRole() sees no identity at all).
DEV_FORWARDED_EMAIL=
